VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# ═══════ API base URL ════════════════════════════════════════════════════
# Leave EMPTY for the relative default: requests go to `/api/v1` on the SAME
# origin as the app. This "just works" through both:
#   • Vite dev-proxy  → http://localhost:3000/api/...  → localhost:5000 (backend)
#   • Docker Nginx    → http://<host>/api/...          → backend:5000
# Only set an absolute URL when the API lives on a DIFFERENT origin (e.g. a
# remote staging server): e.g. VITE_API_URL=https://staging.nivaaran.org
VITE_API_URL=
# ═══════ Demo auth (local SIH demo stack only) ══════════════════════════════
# Explicit opt-in. Set to exactly `true` at build time to enable the demo-login
# bypass in the SPA — this mirrors the backend's DEMO_AUTH_ENABLED flag and
# causes the API client to send `Bearer demo-*` tokens for locally-stored demo
# users. Default (unset / any value other than true) is OFF, so normal
# production deployments never expose the bypass.
#   • Docker Compose passes this via build.args in docker-compose.yml.
#   • Local `vite dev`: add this to your frontend/.env to enable demo login.
VITE_DEMO_AUTH_ENABLED=true
