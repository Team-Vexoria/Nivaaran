# ════════════════════════════════════════════════════════════════════════
#  NIVAARAN Backend — Environment Contract
#
#  Copy this file to `.env` (inside backend/) and fill in real values.
#  ⚠️  `.env` is gitignored — NEVER commit secrets. Only `.env.example` is
#     tracked. See backend/.gitignore.
#
#  Firebase requirement rules:
#    • NODE_ENV=production                                    → credentials REQUIRED
#    • NODE_ENV=development + DEMO_AUTH_ENABLED=false           → credentials REQUIRED
#    • NODE_ENV=development + DEMO_AUTH_ENABLED=true (demo)     → credentials OPTIONAL
#    • NODE_ENV=test                                           → credentials OPTIONAL
# ════════════════════════════════════════════════════════════════════════

# ── Database (required) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nivaaran_db?schema=public

# ── Redis (optional; defaults to redis://localhost:6379) ───────────────────
REDIS_URL=redis://localhost:6379

# ── App (required) ─────────────────────────────────────────────────────────
# Port the HTTP server listens on (frontend Vite dev-proxy targets this port).
PORT=5000
# Allowed frontend origin for CORS.
CLIENT_URL=http://localhost:3000
# development | test | production
NODE_ENV=development

# ── Demo auth (OPTIONAL — local development only) ─────────────────────────
# When BOTH NODE_ENV=development AND DEMO_AUTH_ENABLED=true, the backend starts
# WITHOUT any Firebase credentials and accepts `Bearer demo-*` tokens (each
# maps to exactly one seeded demo user and its role). No role header exists —
# the role is derived from the token alone. This is the only supported way to
# run the server with no Firebase. It is a hard error to set this to true when
# NODE_ENV=production.
DEMO_AUTH_ENABLED=false

# ── Firebase Admin credentials ─────────────────────────────────────────────
# Required unless running in demo or test mode (see rules above). Provide the
# credentials in ONE of the two forms below.

# ── Form 1 — full service-account JSON (preferred for local dev) ──────────
# Paste the complete Firebase service-account JSON here.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com","client_id":"...","private_key_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40your-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# ── OR Form 2 — flat per-field (portable for Docker / Kubernetes) ─────────
# FIREBASE_TYPE=service_account
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY_ID=...
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=...
# FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40your-project-id.iam.gserviceaccount.com

# ── AI / Research (all OPTIONAL — pipeline degrades gracefully) ───────────
GEMINI_API_KEY=
GNEWS_API_KEY=
NEWS_API_KEY=