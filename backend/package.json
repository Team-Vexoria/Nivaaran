{
  "name": "nivaaran-backend",
  "version": "0.1.0",
  "description": "Backend API server for NIVAARAN (SIH 26043)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.spec.ts",
    "verify": "tsx scripts/verify-demo.ts",
    "seed": "tsx prisma/seeds/demo.ts",
    "seed:rbac": "tsx prisma/seeds/rbac.ts",
    "seed:regions": "tsx prisma/seeds/districts.ts",
    "postinstall": "prisma generate || exit 0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
